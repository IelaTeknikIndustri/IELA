---
---

<header class="sticky top-0 z-50 glass-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo & Name -->
      <a href="/" class="flex items-center gap-3.5 group">
        <div class="relative w-11 h-11 rounded-xl bg-slate-900/90 border border-indigo-500/30 p-1 flex items-center justify-center overflow-hidden shadow-lg shadow-indigo-950/40 group-hover:border-indigo-400 transition-colors">
          <img 
            src="/assets/iela-logo.webp" 
            alt="Logo IELA" 
            class="w-full h-full object-contain rounded-lg"
          />
        </div>
        <div>
          <div class="text-base font-black text-white tracking-wide flex items-center gap-1.5">
            <span>IELA</span>
            <span class="text-xs px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-bold border border-indigo-500/30">UNIROW</span>
          </div>
          <p class="text-[10px] text-slate-400 font-medium tracking-wider uppercase">Laboratorium Teknik Industri</p>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-1">
        <a href="/" class="px-3.5 py-2 text-xs font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition">
          Beranda
        </a>
        <a href="#profil" class="px-3.5 py-2 text-xs font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition">
          Profil Lab
        </a>
        <a href="#galeri" class="px-3.5 py-2 text-xs font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition">
          Galeri
        </a>
        <a href="#publikasi" class="px-3.5 py-2 text-xs font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition">
          Publikasi
        </a>
        <a href="/daftar" class="px-3.5 py-2 text-xs font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 transition">
          Recruitment
        </a>
      </nav>

      <!-- Action Button (Login / Portal) -->
      <div class="flex items-center gap-3">
        <a 
          href="/portal"
          class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-400 text-white font-bold text-xs tracking-wide shadow-lg shadow-indigo-600/30 transition-all flex items-center gap-2"
        >
          <i class="fa-solid fa-right-to-bracket text-xs"></i>
          <span>Login Portal</span>
        </a>
      </div>

    </div>
  </div>
</header>
