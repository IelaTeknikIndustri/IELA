---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Portal Autentikasi IELA - Login Asisten & Admin"
  description="Portal Akses Sistem Informasi Manajemen Rekrutmen & Penilaian Laboratorium Teknik Industri UNIROW Tuban."
>
  <Navbar />

  <main class="max-w-md mx-auto px-4 py-16 flex-grow flex flex-col justify-center">
    
    <div class="glass-card p-8 rounded-3xl border border-slate-800 shadow-2xl relative overflow-hidden">
      <!-- Glow ambient -->
      <div class="absolute -top-12 -right-12 w-40 h-40 bg-indigo-600/20 rounded-full blur-2xl pointer-events-none"></div>

      <div class="text-center mb-8 relative z-10">
        <div class="w-16 h-16 rounded-2xl bg-slate-900 border border-indigo-500/30 p-2 mx-auto mb-4 flex items-center justify-center shadow-lg shadow-indigo-950/40">
          <img src="/assets/iela-logo.webp" alt="Logo IELA" class="w-full h-full object-contain" />
        </div>
        <h1 class="text-xl font-black text-white tracking-wide">
          Portal Sistem IELA UNIROW
        </h1>
        <p class="text-xs text-slate-400 mt-1">
          Akses Akun Administrator, Dosen Penguji, dan Asisten Lab
        </p>
      </div>

      <form id="form-login-iela" class="space-y-4 text-xs relative z-10">
        <div>
          <label class="block font-semibold text-slate-300 mb-1.5">Username / NIM</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500">
              <i class="fa-solid fa-user"></i>
            </span>
            <input
              type="text"
              id="login-username"
              name="username"
              required
              placeholder="admin / 1411xxxx"
              class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono transition-colors"
            />
          </div>
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-1.5">Kata Sandi (Password)</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500">
              <i class="fa-solid fa-lock"></i>
            </span>
            <input
              type="password"
              id="login-password"
              name="password"
              required
              placeholder="••••••••"
              class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-800/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition-colors"
            />
          </div>
        </div>

        <div id="login-alert" class="hidden p-3 rounded-xl text-xs"></div>

        <button
          type="submit"
          id="btn-login-submit"
          class="w-full bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-400 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-indigo-600/30 transition-all flex items-center justify-center gap-2 cursor-pointer text-xs"
        >
          <i class="fa-solid fa-right-to-bracket"></i>
          <span>Masuk ke Portal</span>
        </button>

        <div class="p-3 bg-slate-950/60 rounded-xl border border-slate-800 text-[11px] text-slate-400 leading-relaxed text-center">
          <span class="text-indigo-400 font-bold block mb-0.5">Akun Demo Cepat:</span>
          Username: <code class="text-white font-mono font-bold">admin</code> &bull; Password: <code class="text-white font-mono font-bold">admin123</code>
        </div>
      </form>
    </div>

  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('form-login-iela');
  const alertBox = document.getElementById('login-alert');
  const btn = document.getElementById('btn-login-submit');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = (document.getElementById('login-username') as HTMLInputElement).value;
    const password = (document.getElementById('login-password') as HTMLInputElement).value;

    if (btn) {
      btn.setAttribute('disabled', 'true');
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Memeriksa Akun...</span>';
    }

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });
      const json = await res.json();

      if (json.success) {
        if (alertBox) {
          alertBox.className = 'p-3 rounded-xl text-xs bg-emerald-950/60 text-emerald-300 border border-emerald-500/30 block';
          alertBox.textContent = 'Login berhasil! Mengalihkan ke Dashboard...';
        }
        setTimeout(() => {
          window.location.href = json.redirect || '/admin/rekap';
        }, 800);
      } else {
        throw new Error(json.message || 'Login gagal');
      }
    } catch (err: any) {
      if (alertBox) {
        alertBox.className = 'p-3 rounded-xl text-xs bg-rose-950/60 text-rose-300 border border-rose-500/30 block';
        alertBox.textContent = err.message;
      }
      if (btn) {
        btn.removeAttribute('disabled');
        btn.innerHTML = '<i class="fa-solid fa-right-to-bracket"></i> <span>Masuk ke Portal</span>';
      }
    }
  });
</script>

